# Home Assistant REST API
HA_BASE_URL=http://homeassistant.local:8123
HA_TOKEN=PASTE_LONG_LIVED_ACCESS_TOKEN_HERE
HA_VERIFY_SSL=false

# Entity IDs exposed by the ESPHome node / created by this service
HA_LIGHT_ENTITY=light.espscaldabagno_scaldabagno_flash
HA_CAMERA_ENTITY=camera.espscaldabagno_scaldabagno_camera
HA_SENSOR_ENTITY=sensor.scaldabagno_temperature

# Host port for the dashboard
DASHBOARD_PORT=5006
